{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.drvinayjoshi.com"
        }
      ],
      "destination": "https://drvinayjoshi.com/:path*",
      "permanent": true
    },
    {
      "source": "/presentations/Frequently%20Asked%20Questions%20\\(FAQs\\)%20_compressed.pdf",
      "destination": "/presentations/joint-replacement-faq-guide.pdf",
      "permanent": true
    },
    {
      "source": "/presentations/Patient's%20Journey%20and%20Recovery_compressed.pdf",
      "destination": "/presentations/joint-replacement-patient-journey-recovery.pdf",
      "permanent": true
    },
    {
      "source": "/presentations/Patients%20Guide%20to%20Hip%20Replacements_compressed.pdf",
      "destination": "/presentations/hip-replacement-patient-guide.pdf",
      "permanent": true
    },
    {
      "source": "/presentations/Patients%20Guide%20to%20Knee%20Replacements_compressed.pdf",
      "destination": "/presentations/knee-replacement-patient-guide.pdf",
      "permanent": true
    },
    {
      "source": "/Knee%20photo.jpg",
      "destination": "/knee-replacement-mumbai.jpg",
      "permanent": true
    },
    {
      "source": "/Hip%20Image.jpg",
      "destination": "/hip-replacement-mumbai.jpg",
      "permanent": true
    },
    {
      "source": "/Hip%20.jpg",
      "destination": "/hip-replacement-surgery-mumbai.jpg",
      "permanent": true
    },
    {
      "source": "/Prof.jpeg",
      "destination": "/dr-vinay-joshi-orthopaedic-surgeon.jpg",
      "permanent": true
    },
    {
      "source": "/Robo.jpeg",
      "destination": "/robotic-joint-replacement-velys-mumbai.jpg",
      "permanent": true
    },
    {
      "source": "/RoboticSurgery.jpg",
      "destination": "/robotic-surgery-mumbai.jpg",
      "permanent": true
    },
    {
      "source": "/Inspiring%20patient%20whose%20knee%20replaced.jpeg",
      "destination": "/high-flex-knee-replacement-patient-mumbai.jpg",
      "permanent": true
    },
    {
      "source": "/Dancing%20patient%20video.mp4",
      "destination": "/knee-replacement-patient-recovery-mumbai.mp4",
      "permanent": true
    },
    {
      "source": "/Profile%20picture.png",
      "destination": "/dr-vinay-joshi-profile-mumbai.png",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|mp4|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
